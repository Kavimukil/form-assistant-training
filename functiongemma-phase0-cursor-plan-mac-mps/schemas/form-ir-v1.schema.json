{
  "$defs": {
    "DependencyRule": {
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "when_field_id": {
          "title": "When Field Id",
          "type": "string"
        },
        "when_value": {
          "default": null,
          "title": "When Value"
        },
        "then_field_id": {
          "title": "Then Field Id",
          "type": "string"
        },
        "effect": {
          "enum": [
            "require",
            "hide",
            "set_default"
          ],
          "title": "Effect",
          "type": "string"
        },
        "default_value": {
          "default": null,
          "title": "Default Value"
        }
      },
      "required": [
        "rule_id",
        "when_field_id",
        "then_field_id",
        "effect"
      ],
      "title": "DependencyRule",
      "type": "object"
    },
    "FieldSpec": {
      "properties": {
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "enum",
            "date",
            "multi"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "min_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Length"
        },
        "max_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Length"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/OptionSpec"
          },
          "title": "Options",
          "type": "array"
        },
        "ontology_lineage": {
          "default": "",
          "title": "Ontology Lineage",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "label",
        "type"
      ],
      "title": "FieldSpec",
      "type": "object"
    },
    "OptionSpec": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "OptionSpec",
      "type": "object"
    }
  },
  "properties": {
    "schema_id": {
      "title": "Schema Id",
      "type": "string"
    },
    "schema_family_id": {
      "title": "Schema Family Id",
      "type": "string"
    },
    "template_lineage_id": {
      "title": "Template Lineage Id",
      "type": "string"
    },
    "ontology_lineage_id": {
      "title": "Ontology Lineage Id",
      "type": "string"
    },
    "locale": {
      "default": "en-IN",
      "title": "Locale",
      "type": "string"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FieldSpec"
      },
      "title": "Fields",
      "type": "array"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/DependencyRule"
      },
      "title": "Dependencies",
      "type": "array"
    }
  },
  "required": [
    "schema_id",
    "schema_family_id",
    "template_lineage_id",
    "ontology_lineage_id",
    "fields"
  ],
  "title": "FormIR",
  "type": "object"
}
